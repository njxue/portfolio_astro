---
const { href, text, icon } = Astro.props;
---

<a href={`#${href}`} aria-label={href}>
  <div class="flex flex-row gap-1 transition-all hover:scale-105">
    {
      icon && (
        <div class="dark:invert">
          <img class="w-5" src={`/icons/${icon}`} alt="" />
        </div>
      )
    }
    <p class="hidden sm:block">{text}</p>
  </div>
</a>
